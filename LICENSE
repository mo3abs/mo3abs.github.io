function go(tab){
  ui.tab=tab;
  ["today","college","cyber","ai"].forEach(t=>$("#v-"+t).classList.toggle("hidden",t!==tab));
  document.body.classList.toggle("in-ai",tab==="ai");
  $$("#tabbar button").forEach(b=>b.classList.toggle("on",b.dataset.tab===tab));
  try{localStorage.setItem(TABKEY,tab)}catch(e){}
  if(tab==="college")renderCollege();
  if(tab==="ai"){renderAI();window.scrollTo({top:document.body.scrollHeight});return}
  window.scrollTo({top:0});
}
$("#tabbar").addEventListener("click",e=>{const b=e.target.closest("[data-tab]");if(b)go(b.dataset.tab)});

function bindSeg(id,cb){
  $(id).addEventListener("click",e=>{
    const b=e.target.closest("button");if(!b)return;
    $$("button",$(id)).forEach(x=>x.classList.toggle("on",x===b));
    cb(b.dataset.v);
  });
}
bindSeg("#segCol",v=>{ui.col=v;renderCollege()});
bindSeg("#segCy",v=>{
  ui.cy=v;
  ["g","soc","proj","news"].forEach(k=>$("#cy-"+k).style.display=k===v?"":"none");
  if(v==="news"&&!ui.newsLoaded){ui.newsLoaded=true;loadNews()}
});
$("#cySearch").addEventListener("input",applySearch);

/* click delegation */
document.addEventListener("click",e=>{
  const b=e.target.closest("[data-act]");if(!b)return;
  const a=b.dataset.act;
  if(a==="c"){
    const id=b.dataset.id;
    if(done[id])delete done[id];else{done[id]=true;markActivity()}
    lsSet(DKEY,done);renderToday();if(ui.tab==="college")renderCollege();
  }else if(a==="cy"){toggleRefId(b.dataset.id)}
  else if(a==="gday"){toggleGoogle(+b.dataset.i)}
  else if(a==="week"){toggleWeek(+b.dataset.i,+b.dataset.j)}
  else if(a==="del"){
    const iso=isoOf(new Date());
    custom[iso]=(custom[iso]||[]).filter(x=>x.id!==b.dataset.id);
    delete done[b.dataset.id];
    lsSet(CKEY,custom);lsSet(DKEY,done);renderToday();
  }else if(a==="socopen"){b.closest(".soc").classList.toggle("open")}
});

/* add custom task */
$("#addForm").addEventListener("submit",e=>{
  e.preventDefault();
  const inp=$("#addInput"),v=inp.value.trim();if(!v)return;
  const iso=isoOf(new Date());
  (custom[iso]=custom[iso]||[]).push({id:`cu-${Date.now()}`,t:v});
  lsSet(CKEY,custom);inp.value="";renderToday();
});

