function classRow(c){
  return `<div class="cls"><div class="time">${c.a} – ${c.b}</div>
    <div class="fx"><div class="ttl" style="direction:ltr;text-align:right">${esc(c.s)}</div><div class="sub">${esc(c.r)} · ${esc(c.t)}</div></div>
    <span class="tag t-${KIND[c.k].c}">${KIND[c.k].n}</span></div>`;
}
function renderCollege(){
  const body=$("#colBody"),now=new Date(),todayDow=now.getDay();
  if(ui.col==="week"){
    body.innerHTML=WEEK_ORDER.map(d=>{
      const cl=SCHEDULE[d]||[];
      return `<div class="glass day-card ${d===todayDow?"today":""}">
        <div class="day-head"><h3>${DAYS[d]}</h3>${d===todayDow?'<span class="tag t-blue">النهاردة</span>':`<span class="sub">${cl.length} حصص</span>`}</div>
        ${cl.length?cl.map(classRow).join(""):'<div class="empty">مفيش محاضرات</div>'}
      </div>`}).join("")+
      `<div class="glass day-card"><div class="day-head"><h3>الجمعة</h3><span class="sub">إجازة</span></div><div class="empty">يوم راحة أو مذاكرة حرة</div></div>`;
  }else if(ui.col==="exams"){
    let h=`<div class="glass group">`+EXAMS.map(e=>{
      const dd=dayDiff(e.d,now);
      const txt=dd<0?"خلص":dd===0?"النهاردة":dd===1?"بكرة":`بعد ${dd} يوم`;
      return `<div class="row"><div class="fx"><div class="ttl" style="direction:ltr;text-align:right">${esc(e.s)}</div>
        <div class="sub">${dateLong(new Date(e.d+"T12:00:00"))} · 10:00 – 11:00</div></div>
        <span class="ex-count" style="${dd<0?"color:var(--label3)":""}">${txt}</span></div>`}).join("")+`</div>`;
    h+=`<h2 class="sec">خطة المذاكرة</h2>`;
    h+=Object.keys(PLAN).sort().map(iso=>{
      const dd=new Date(iso+"T12:00:00");
      const tasks=PLAN[iso];
      return `<div class="glass group" style="margin-bottom:12px"><div class="sec-label">${dateLong(dd)}${iso===isoOf(now)?' · <span style="color:var(--blue)">النهاردة</span>':""}</div>`+
        tasks.map((x,n)=>{const id=`col-${iso}-${n}`;return `<div class="row ${done[id]?"done":""}">
          <button class="ck" type="button" data-act="c" data-id="${id}"><i class="fa-solid fa-check"></i></button>
          <div class="fx"><div class="ttl">${esc(x.t)}</div><div class="sub"><span class="tag t-blue">${esc(x.s)}</span> · ${x.m} دقيقة</div></div></div>`}).join("")+`</div>`;
    }).join("");
    body.innerHTML=h;
  }else{
    const map={};
    Object.keys(SCHEDULE).forEach(d=>(SCHEDULE[d]||[]).forEach(c=>{(map[c.s]=map[c.s]||[]).push({d:+d,c})}));
    body.innerHTML=Object.keys(map).sort().map(s=>`
      <div class="glass subj"><h3>${esc(s)}</h3>
      ${map[s].map(x=>`<div class="line"><span class="tag t-${KIND[x.c.k].c}">${KIND[x.c.k].n}</span> ${DAYS[x.d]} ${x.c.a} · ${esc(x.c.r)}</div>`).join("")}
      </div>`).join("");
  }
}

