function renderSurahs(){
  const q=($("#surahSearch").value||"").trim();
  const res=surahs.filter(s=>s[1].includes(q)||s[0].includes(q));
  $("#surahList").innerHTML=res.length?res.map(s=>`
    <div class="surah ${s[0]===activeSurah?"on":""}" data-s="${s[0]}"><span>${esc(s[1])}</span>
    <span><small>${s[0]}</small><i class="fa-solid ${s[0]===activeSurah&&!audio.paused?"fa-volume-high":"fa-play"}"></i></span></div>`).join("")
    :`<div class="loading">مش لاقي السورة دي</div>`;
}
$("#surahSearch").addEventListener("input",renderSurahs);
$("#surahList").addEventListener("click",e=>{
  const r=e.target.closest("[data-s]");if(!r)return;
  const s=surahs.find(x=>x[0]===r.dataset.s);if(s)playSurah(s);
});
function playSurah(s){
  activeSurah=s[0];
  audio.src=`https://server8.mp3quran.net/lhdan/${s[0]}.mp3`;
  audio.play().then(()=>{
    $("#mTitle").textContent=s[1];
    mini.classList.add("show");
    syncPlay();renderSurahs();
  }).catch(()=>{});
}
function syncPlay(){$("#mPlay").innerHTML=audio.paused?'<i class="fa-solid fa-play"></i>':'<i class="fa-solid fa-pause"></i>'}
function rel(step){
  const i=surahs.findIndex(x=>x[0]===activeSurah);if(i<0)return;
  playSurah(surahs[(i+step+surahs.length)%surahs.length]);
}
$("#mPrev").addEventListener("click",()=>rel(-1));
$("#mNext").addEventListener("click",()=>rel(1));
$("#mPlay").addEventListener("click",()=>{
  if(!activeSurah)return;
  if(audio.paused)audio.play().catch(()=>{});else audio.pause();
});
audio.addEventListener("play",syncPlay);
audio.addEventListener("pause",syncPlay);
audio.addEventListener("ended",()=>rel(1));

