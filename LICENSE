const AIK="lifeos_gemini_key",AIM="lifeos_gemini_model",AIH="lifeos_ai_hist",AIB="lifeos_ai_brief_";
const GEM="https://generativelanguage.googleapis.com/v1beta/";
const rd=(k,f)=>{try{return localStorage.getItem(k)||f}catch(e){return f}};
let aiKey=rd(AIK,""),aiModel=rd(AIM,"gemini-flash-latest");
let aiMsgs=lsGet(AIH,[]);
let aiBusy=false,briefBusy=false;

function aiContext(){
  const now=new Date(),iso=isoOf(now),dow=now.getDay();
  const cls=d=>(SCHEDULE[d]||[]).map(c=>`${c.a}-${c.b} ${c.s} (${KIND[c.k].n}, ${c.r})`).join("؛ ")||"مفيش محاضرات";
  const col=collegeTasks(iso,dow).map(x=>`- [${done[x.id]?"تم":"لسه"}] ${x.s}: ${x.t} (${x.m} دقيقة)`).join("\n");
  const ref=cyberToday(iso),ci=ref?refInfo(ref):null;
  const ex=EXAMS.filter(e=>dayDiff(e.d,now)>=0).map(e=>`${e.s}: ${dateLong(new Date(e.d+"T12:00:00"))} الساعة 10:00-11:00 (بعد ${dayDiff(e.d,now)} يوم)`).join("\n")||"مفيش امتحانات جاية";
  const ct=cyberTotals();
  return `الوقت دلوقتي: ${dateLong(now)} ${pad(now.getHours())}:${pad(now.getMinutes())}
محاضرات النهاردة: ${cls(dow)}
محاضرات بكرة: ${cls((dow+1)%7)}
مهام الكلية النهاردة:
${col||"- مفيش"}
مهمة السايبر النهاردة: ${ci?`[${ci.done?"تم":"لسه"}] ${ci.sub} — ${ci.title}`:"خلّص المسار"}
تقدم السايبر: ${cyberPercent()}% (${ct.gd}/${googleDays.length} يوم Google)
امتحانات الميد تيرم الجاية:
${ex}
سلسلة الأيام المتتالية: ${streak()}`;
}
function aiSystem(){
  return `انت المساعد الشخصي لمحمد أحمد عبد السلام، طالب في الفرقة الأولى برنامج العلوم الأساسية بكلية العلوم الصحية التطبيقية (جامعة برج العرب التكنولوجية)، وبيتعلم سايبر سيكيورتي بخطة Google Cybersecurity ثم مسار SOC Analyst.
اتكلم بالعامية المصرية بأسلوب صاحب شاطر: مختصر ومباشر وعملي، من غير مقدمات ولا حشو. استخدم المصطلحات التقنية بالإنجليزي زي ما هي.
لما تشرح: ابدأ بالفكرة في جملتين، بعدين مثال، وبعدين نقطة تثبيت. ولما يطلب خطة: رتبها بأوقات واقعية حسب جدوله.
اعتمد على بيانات محمد الحالية دي، ومتخترعش معلومات مش موجودة فيها:
${aiContext()}`;
}

const partsText=j=>((j.candidates||[])[0]?.content?.parts||[]).map(p=>p.text||"").join("");
async function discoverModel(){
  const r=await fetch(GEM+"models?pageSize=200",{headers:{"x-goog-api-key":aiKey}});
  if(!r.ok)throw Object.assign(new Error("HTTP "+r.status),{status:r.status});
  const names=((await r.json()).models||[]).filter(m=>(m.supportedGenerationMethods||[]).includes("generateContent")&&/gemini/.test(m.name)).map(m=>m.name.replace("models/",""));
  if(!names.length)throw new Error("مفيش موديلات متاحة للمفتاح ده");
  let pick=names.includes("gemini-flash-latest")?"gemini-flash-latest":null;
  if(!pick){
    const fl=names.filter(n=>/flash/.test(n)&&!/lite|image|tts|live|exp|preview|thinking|audio|robotics|computer/.test(n))
      .sort((a,b)=>parseFloat((b.match(/gemini-(\d+(?:\.\d+)?)/)||[0,0])[1])-parseFloat((a.match(/gemini-(\d+(?:\.\d+)?)/)||[0,0])[1]));
    pick=fl[0]||names.find(n=>/flash/.test(n))||names[0];
  }
  aiModel=pick;try{localStorage.setItem(AIM,aiModel)}catch(_){}
  const mi=$("#aiModelIn");if(mi)mi.value=aiModel;
  return pick;
}
async function gemCall(contents,opt={}){
  try{return await gemCallRaw(contents,opt)}
  catch(e){
    if(e.status===404&&!opt._retried&&aiKey){await discoverModel();return await gemCallRaw(contents,{...opt,_retried:true})}
    throw e;
  }
}
async function gemCallRaw(contents,{system,json,onChunk}={}){
  if(!aiKey)throw Object.assign(new Error("NOKEY"),{code:"NOKEY"});
  const body={contents,generationConfig:{temperature:json?.4:.7}};
  if(system)body.systemInstruction={parts:[{text:system}]};
  if(json)body.generationConfig.responseMimeType="application/json";
  const stream=!!onChunk;
  const url=GEM+`models/${encodeURIComponent(aiModel)}:${stream?"streamGenerateContent?alt=sse":"generateContent"}`;
  const r=await fetch(url,{method:"POST",headers:{"Content-Type":"application/json","x-goog-api-key":aiKey},body:JSON.stringify(body)});
  if(!r.ok){let m="";try{m=(await r.json()).error.message}catch(e){}throw Object.assign(new Error(m||("HTTP "+r.status)),{status:r.status})}
  if(!stream){const t=partsText(await r.json());if(!t)throw new Error("EMPTY");return t}
  const reader=r.body.getReader(),dec=new TextDecoder();let buf="",full="";
  for(;;){
    const {done:fin,value}=await reader.read();if(fin)break;
    buf+=dec.decode(value,{stream:true});
    let i;
    while((i=buf.indexOf("\n"))>=0){
      const line=buf.slice(0,i).trim();buf=buf.slice(i+1);
      if(line.startsWith("data:")){try{const t=partsText(JSON.parse(line.slice(5)));if(t){full+=t;onChunk(full)}}catch(e){}}
    }
  }
  if(!full)throw new Error("EMPTY");
  return full;
}
const errFull=e=>errMsg(e)+(e.code==="NOKEY"?"":` [${e.status||e.name||""} ${String(e.message||"").slice(0,150)}]`);
function errMsg(e){
  if(e.code==="NOKEY")return "ضيف الـ API Key الأول من الإعدادات.";
  if(e.message==="EMPTY")return "الرد رجع فاضي أو اتحجب، جرّب صيغة تانية.";
  if(e.status===400&&/key/i.test(e.message))return "المفتاح غلط أو مش شغال. راجعه من الإعدادات.";
  if(e.status===403)return "المفتاح مرفوض أو متقيّد بنطاق تاني. راجع صلاحياته في Google AI Studio.";
  if(e.status===404)return "اسم الموديل مش موجود. افتح الإعدادات واختار موديل من القائمة.";
  if(e.status===429)return "وصلت للحد المجاني دلوقتي، استنى شوية وجرّب تاني.";
  if(e.name==="TypeError")return "مفيش اتصال بالنت أو المتصفح منع الطلب.";
  return "حصلت مشكلة: "+e.message;
}

/* بدون مفتاح: افتح ChatGPT / Claude / Google AI والسؤال جاهز */
const PROV={chatgpt:{n:"ChatGPT",u:"https://chatgpt.com/?q="},claude:{n:"Claude",u:"https://claude.ai/new?q="},google:{n:"Google AI",u:"https://www.google.com/search?udm=50&q="}};
let aiProv=rd("lifeos_prov","chatgpt");if(!PROV[aiProv])aiProv="chatgpt";
function shortCtx(){
  const now=new Date(),dow=now.getDay();
  const cls=(SCHEDULE[dow]||[]).map(c=>`${c.a} ${c.s}`).join("، ")||"مفيش محاضرات";
  const nx=EXAMS.find(e=>dayDiff(e.d,now)>=0);
  const ci=(()=>{const r=cyberToday(isoOf(now));return r?refInfo(r).title:""})();
  return `(معلومة عني: طالب سنة أولى علوم أساسية، اليوم ${dateLong(now)}، محاضراتي: ${cls}${nx?`، الامتحان الجاي ${nx.s} يوم ${dateLong(new Date(nx.d+"T12:00:00"))}`:""}${ci?`، بذاكر سايبر سيكيورتي ومهمة النهاردة: ${ci}`:""}. رد بالعامية المصرية باختصار.)`;
}
function askExternal(text){
  const q=encodeURIComponent(text+"\n\n"+shortCtx());
  const w=window.open(PROV[aiProv].u+q,"_blank");
  if(w){try{w.opener=null}catch(e){}}
  else{const el=$("#aiOnMsg");if(el)el.textContent="المتصفح منع فتح التاب. اسمح بالنوافذ المنبثقة للموقع."}
}

/* markdown صغير وآمن */
function inl(t){
  let h=esc(t);
  h=h.replace(/`([^`\n]+)`/g,"<code>$1</code>").replace(/\*\*([^*\n]+)\*\*/g,"<b>$1</b>").replace(/^#{1,3}\s*(.+)$/gm,"<h5>$1</h5>");
  h=h.replace(/(?:^|\n)((?:[-*•]\s+.+(?:\n|$))+)/g,(m,b)=>"\n<ul>"+b.trim().split("\n").map(l=>"<li>"+l.replace(/^[-*•]\s+/,"")+"</li>").join("")+"</ul>\n");
  h=h.replace(/(?:^|\n)((?:\d+[.)]\s+.+(?:\n|$))+)/g,(m,b)=>"\n<ol>"+b.trim().split("\n").map(l=>"<li>"+l.replace(/^\d+[.)]\s+/,"")+"</li>").join("")+"</ol>\n");
  return h.trim().replace(/<\/(ul|ol|h5)>\n+/g,"</$1>").replace(/\n+<(ul|ol|h5)>/g,"<$1>").replace(/\n/g,"<br>");
}
function md(s){return String(s).split("```").map((p,i)=>i%2?`<pre>${esc(p.replace(/^[\w+-]*\n/,"").trim())}</pre>`:inl(p)).join("")}

/* chat */
const CHIPS=[
  ["fa-sun","خطة يومي","اعملي خطة تفصيلية لباقي يومي النهاردة بأوقات واقعية حسب محاضراتي ومهامي."],
  ["fa-shield-halved","اشرحلي السايبر","اشرحلي مهمة السايبر بتاعة النهاردة من الأول، بتبسيط وأمثلة، وبعدها قولي إيه أهم 3 حاجات أركّز عليها."],
  ["fa-circle-question","اختبرني سايبر","@quiz:cyber"],
  ["fa-flask","اختبرني كلية","@quiz:college"],
  ["fa-book-open","ذاكرلي الامتحان الجاي","جهزلي ملخص مذاكرة للامتحان الجاي: أهم العناوين اللي ممكن تيجي في امتحان ميد تيرم لمادة مرحلة أولى، وطريقة مذاكرة في الوقت المتاح."]
];
function renderChips(){
  $("#aiChips").innerHTML=CHIPS.map((c,i)=>`<button class="chip w" type="button" data-chip="${i}"><i class="fa-solid ${c[0]}"></i> ${c[1]}</button>`).join("");
}
function quizHTML(m,i){
  const ans=m.ans||[];const fin=m.qs.every((_,k)=>ans[k]!==undefined&&ans[k]!==null);
  const score=m.qs.reduce((a,q,k)=>a+(ans[k]===q.a?1:0),0);
  return `<div class="bub ai qz"><h4><i class="fa-solid fa-circle-question" style="color:var(--blue)"></i> ${esc(m.title)}</h4>`+
  m.qs.map((q,k)=>{
    const got=ans[k];const has=got!==undefined&&got!==null;
    return `<div class="qq"><p>${k+1}. ${esc(q.q)}</p>`+q.o.map((o,j)=>`<button class="qo ${has?(j===q.a?"ok":j===got?"bad":""):""}" type="button" ${has?"disabled":""} data-qz="${i}:${k}:${j}">${esc(o)}</button>`).join("")+
    (has&&q.e?`<div class="qe">${esc(q.e)}</div>`:"")+`</div>`}).join("")+
  (fin?`<div class="qscore">نتيجتك ${score} من ${m.qs.length}</div>`:"")+`</div>`;
}
function renderAI(){
  const box=$("#aiMsgs");
  $("#aiIn").placeholder=aiKey?"اسألني أي حاجة...":"اكتب سؤالك وهيتفتح في "+PROV[aiProv].n;
  if(!aiMsgs.length){
    box.innerHTML=`<div class="glass ai-empty"><div class="big"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
      <h3>اسأل أي حاجة</h3>
      <div class="sub">${aiKey?"المساعد المدمج شغال ✓ اكتب سؤالك تحت.":"اكتب سؤالك تحت وهيتفتح الرد في التطبيق اللي تختاره، وسؤالك معاه ملخص جدولك. من غير إعداد ولا مفاتيح."}</div>
      ${aiKey?"":`<div class="qlinks">${Object.keys(PROV).map(k=>`<button type="button" class="chip w ${k===aiProv?"sel":""}" data-prov="${k}">${PROV[k].n}</button>`).join("")}</div>
      <div class="set-msg" id="aiOnMsg"></div>
      <details class="adv"><summary>عايز الرد يظهر جوه الموقع؟ فعّل Gemini</summary>
        <ol class="steps"><li>افتح <a href="https://aistudio.google.com/apikey" target="_blank" rel="noopener noreferrer">aistudio.google.com/apikey</a> واعمل مفتاح واضغط Copy</li><li>ارجع هنا واضغط الزرار ده</li></ol>
        <div style="text-align:center"><button class="btn" type="button" data-paste="1"><i class="fa-solid fa-paste"></i> الصق المفتاح من الحافظة</button></div>
      </details>`}</div>`;
    return;
  }
  $("#aiIn").placeholder=aiKey?"اسألني أي حاجة...":"اكتب سؤالك وهيتفتح في "+PROV[aiProv].n;
  const last=aiMsgs[aiMsgs.length-1];
  box.innerHTML=aiMsgs.map((m,i)=>{
    if(m.role==="quiz")return quizHTML(m,i);
    if(m.role==="user")return `<div class="bub me">${esc(m.text).replace(/\n/g,"<br>")}</div>`;
    if(!m.text&&aiBusy&&m===last)return `<div class="bub ai"><span class="dots"><i></i><i></i><i></i></span></div>`;
    return `<div class="bub ai ${m.err?"err":""}">${md(m.text)}</div>`;
  }).join("");
  if(ui.tab==="ai")window.scrollTo({top:document.body.scrollHeight,behavior:"auto"});
}
function saveAI(){lsSet(AIH,aiMsgs.slice(-40).filter(m=>!(m.role==="model"&&!m.text)))}

async function sendAI(text){
  text=(text||"").trim();if(!text||aiBusy)return;
  if(!aiKey){askExternal(text);return}
  go("ai");
  aiMsgs.push({role:"user",text});
  const m={role:"model",text:""};aiMsgs.push(m);aiBusy=true;renderAI();
  try{
    let hist=aiMsgs.slice(0,-1).filter(x=>x.role==="user"||(x.role==="model"&&x.text&&!x.err)).slice(-16).map(x=>({role:x.role,parts:[{text:x.text}]}));
    while(hist.length&&hist[0].role!=="user")hist.shift();
    await gemCall(hist,{system:aiSystem(),onChunk:t=>{m.text=t;renderAI()}});
  }catch(e){m.text=errMsg(e);m.err=true}
  aiBusy=false;saveAI();renderAI();
}

async function makeQuiz(kind){
  if(!aiKey){askExternal(kind==="cyber"?"اختبرني 5 أسئلة اختيار من متعدد في موضوع السايبر سيكيورتي اللي بذاكره النهاردة، واحد واحد، وصحح إجاباتي.":"اختبرني 5 أسئلة اختيار من متعدد في مادة الامتحان الجاي بتاعي، واحد واحد، وصحح إجاباتي.");return}
  if(aiBusy)return;
  const now=new Date(),iso=isoOf(now);
  let topic,title;
  if(kind==="cyber"){
    const ref=cyberToday(iso),ci=ref&&refInfo(ref);
    topic=ci?`${ci.sub} — ${ci.title}`:"أساسيات SOC وأمن المعلومات";title="اختبار سايبر: "+(ci?ci.title:"مراجعة عامة");
  }else{
    const nx=EXAMS.find(e=>dayDiff(e.d,now)>=0);
    topic=nx?`مادة ${nx.s} لطالب مرحلة أولى علوم صحية تطبيقية (ميد تيرم)`:"مواد الفرقة الأولى علوم أساسية";title="اختبار كلية: "+(nx?nx.s:"مراجعة");
  }
  go("ai");
  const m={role:"model",text:""};aiMsgs.push({role:"user",text:"اختبرني: "+title});aiMsgs.push(m);aiBusy=true;renderAI();
  try{
    const p=`اعمل اختبار من 5 أسئلة اختيار من متعدد (4 اختيارات لكل سؤال) في الموضوع ده: ${topic}. الأسئلة بالعربي المصري المبسط والمصطلحات التقنية بالإنجليزي، متدرجة من سهل لصعب. رجّع JSON فقط بالشكل: [{"q":"السؤال","o":["أ","ب","ج","د"],"a":رقم_الإجابة_الصحيحة_من_0_لـ3,"e":"شرح قصير للإجابة"}]`;
    const raw=await gemCall([{role:"user",parts:[{text:p}]}],{json:true});
    const arr=JSON.parse(raw.replace(/^```(?:json)?|```$/g,"").trim());
    const qs=(Array.isArray(arr)?arr:[]).filter(q=>q&&q.q&&Array.isArray(q.o)&&q.o.length>=2&&Number.isInteger(q.a)&&q.a>=0&&q.a<q.o.length).slice(0,5);
    if(!qs.length)throw new Error("EMPTY");
    aiMsgs.splice(aiMsgs.indexOf(m),1,{role:"quiz",title,qs,ans:[]});
  }catch(e){m.text=e instanceof SyntaxError?"مقدرتش أطلّع الاختبار بشكل سليم، جرّب تاني.":errMsg(e);m.err=true}
  aiBusy=false;saveAI();renderAI();
}

/* brief on Today */
function renderAIBrief(){
  const box=$("#tAI");if(!box)return;
  const iso=isoOf(new Date()),cached=lsGet(AIB+iso,null);
  const head=`<div class="brief-h"><span class="sp"><i class="fa-solid fa-wand-magic-sparkles"></i></span><b>خطة اليوم من المساعد</b>${cached&&!briefBusy?`<button class="del" type="button" data-brief="1" aria-label="تحديث"><i class="fa-solid fa-rotate"></i></button>`:""}</div>`;
  let inner;
  if(briefBusy)inner=`<span class="dots"><i></i><i></i><i></i></span>`;
  else if(cached)inner=`<div class="bub ai">${md(cached)}</div>`;
  else inner=`<div class="sub">خلّي المساعد يرتبلك يومك على حسب جدولك.</div><button class="btn soft" style="margin-top:10px" type="button" data-brief="1">اطلعلي خطة النهاردة</button>`;
  box.innerHTML=`<div class="brief glass">${head}${inner}</div>`;
}
async function genBrief(){
  if(!aiKey){askExternal("اعملي خطة النهاردة في 5 أو 6 نقاط قصيرة بأوقات واقعية بين محاضراتي، فيها مذاكرة كلية وسايبر وراحة.");return}
  if(briefBusy)return;
  briefBusy=true;renderAIBrief();
  try{
    const t=await gemCall([{role:"user",parts:[{text:"اكتبلي خطة النهاردة في 5 أو 6 نقاط قصيرة جداً بأوقات واقعية بين محاضراتي، وفيها وقت مذاكرة الكلية والسايبر وراحة. آخر سطر: نصيحة واحدة تحفيزية واقعية. من غير مقدمة."}]}],{system:aiSystem()});
    lsSet(AIB+isoOf(new Date()),t);
  }catch(e){try{localStorage.removeItem(AIB+isoOf(new Date()))}catch(_){} $("#tAI").innerHTML=`<div class="brief glass"><div class="sub" style="color:var(--red)">${esc(errMsg(e))}</div></div>`;briefBusy=false;return}
  briefBusy=false;renderAIBrief();
}

