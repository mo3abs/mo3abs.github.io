  const d=document.createElement("span");d.className="tap-fx";d.style.left=e.clientX+"px";d.style.top=e.clientY+"px";
  document.body.appendChild(d);setTimeout(()=>d.remove(),650);
  if(navigator.vibrate&&e.pointerType==="touch"){try{navigator.vibrate(8)}catch(_){}}
},{passive:true});
