$("#aiSave").addEventListener("click",async()=>{
  aiKey=$("#aiKeyIn").value.trim();aiModel=$("#aiModelIn").value.trim()||"gemini-flash-latest";
  try{localStorage.setItem(AIK,aiKey);localStorage.setItem(AIM,aiModel)}catch(e){}
  if(!aiKey){setMsg("اتمسح المفتاح.","ok");renderAI();renderAIBrief();return}
  setMsg("بختبر الاتصال...");
  try{await gemCall([{role:"user",parts:[{text:"رد بكلمة واحدة: تمام"}]}]);setMsg("الاتصال شغال ✓","ok");renderAI();renderAIBrief()}
  catch(e){setMsg(errFull(e),"bad")}
});
$("#aiList").addEventListener("click",async()=>{
  if(!($("#aiKeyIn").value.trim()))return setMsg("حط المفتاح الأول.","bad");
  setMsg("بجيب الموديلات...");
  try{
    const r=await fetch(GEM+"models?pageSize=100",{headers:{"x-goog-api-key":$("#aiKeyIn").value.trim()}});
    if(!r.ok)throw Object.assign(new Error("HTTP "+r.status),{status:r.status});
    const j=await r.json();
    const names=(j.models||[]).filter(m=>(m.supportedGenerationMethods||[]).includes("generateContent")&&/gemini/.test(m.name)).map(m=>m.name.replace("models/",""));
    $("#aiModels").innerHTML=names.map(n=>`<option value="${esc(n)}">`).join("");
    setMsg(`لقيت ${names.length} موديل — اضغط على خانة الموديل واختار.`,"ok");
  }catch(e){setMsg(errMsg(e),"bad")}
});
$("#aiClear").addEventListener("click",()=>{aiMsgs=[];saveAI();renderAI();setMsg("اتمسحت المحادثة.","ok")});

/* events */
$("#aiForm").addEventListener("submit",e=>{e.preventDefault();const t=$("#aiIn");const v=t.value;t.value="";t.style.height="auto";sendAI(v)});
$("#aiIn").addEventListener("input",e=>{const t=e.target;t.style.height="auto";t.style.height=Math.min(t.scrollHeight,120)+"px"});
$("#aiIn").addEventListener("keydown",e=>{if(e.key==="Enter"&&!e.shiftKey&&!e.isComposing&&window.innerWidth>700){e.preventDefault();$("#aiForm").requestSubmit()}});
document.addEventListener("click",e=>{
  const t=e.target;
  let b=t.closest("[data-chip]");
  if(b){const c=CHIPS[+b.dataset.chip][2];if(c.startsWith("@quiz:"))makeQuiz(c.slice(6));else sendAI(c);return}
  if(b=t.closest("[data-prov]")){aiProv=b.dataset.prov;try{localStorage.setItem("lifeos_prov",aiProv)}catch(_){}renderAI();return}
  if(b=t.closest("[data-ai-ask]")){sendAI(b.dataset.aiAsk);return}
  if(b=t.closest("[data-aiset]")){openAISet();return}
  if(b=t.closest("[data-brief]")){try{localStorage.removeItem(AIB+isoOf(new Date()))}catch(_){} genBrief();return}
  if(b=t.closest("[data-qz]")){
    const [i,k,j]=b.dataset.qz.split(":").map(Number),m=aiMsgs[i];
    if(m&&m.role==="quiz"&&(m.ans[k]===undefined||m.ans[k]===null)){m.ans[k]=j;saveAI();renderAI()}
  }
});
renderChips();renderAI();

/* =====================================================
   THEME + WEATHER + CLOCK
===================================================== */
const THK="lifeos_theme";
let themePref=rd(THK,"auto");
const mq=window.matchMedia?matchMedia("(prefers-color-scheme: dark)"):null;
function applyTheme(){
  const dark=themePref==="dark"||(themePref==="auto"&&mq&&mq.matches);
  document.documentElement.dataset.mode=dark?"dark":"light";
  const m=document.querySelector('meta[name=theme-color]');if(m)m.content=dark?"#000000":"#f4f5fb";
  $$("#themeSeg button").forEach(b=>b.classList.toggle("on",b.dataset.v===themePref));
}
if(mq&&mq.addEventListener)mq.addEventListener("change",applyTheme);
$("#themeSeg").addEventListener("click",e=>{
  const b=e.target.closest("button");if(!b)return;
  themePref=b.dataset.v;try{localStorage.setItem(THK,themePref)}catch(_){}
  applyTheme();
});
const setSheet=$("#setSheet");
function openSet(){applyTheme();paintSalah();paintInstall();setSheet.classList.add("show");sheetBg.classList.add("show")}
function closeAll(){[setSheet,aiSet,sheet].forEach(x=>x.classList.remove("show"));sheetBg.classList.remove("show")}
$("#setBtn").addEventListener("click",openSet);
sheetBg.addEventListener("click",closeAll);
document.addEventListener("keydown",e=>{if(e.key==="Escape")closeAll()});
document.addEventListener("click",e=>{
  if(e.target.closest("[data-aiset]")){setSheet.classList.remove("show");if(!aiSet.classList.contains("show"))sheetBg.classList.remove("show");openAISet()}
  if(e.target.closest("[data-paste]"))pasteKey();
});
applyTheme();

/* paste key in one tap */
async function pasteKey(){
  const msg=t=>{const el=$("#aiOnMsg");if(el)el.textContent=t};
  let k="";
  try{k=(await navigator.clipboard.readText()).trim()}catch(e){msg("المتصفح منع قراءة الحافظة. افتح ⚙️ من فوق والصق المفتاح هناك.");return}
  if(k.length<20){msg("الحافظة مفيهاش مفتاح. انسخ المفتاح الأول وجرّب تاني.");return}
  aiKey=k;try{localStorage.setItem(AIK,aiKey)}catch(_){}
  msg("بختبر المفتاح...");
  try{await gemCall([{role:"user",parts:[{text:"رد بكلمة واحدة: تمام"}]}]);renderAI();renderAIBrief()}
  catch(e){aiKey="";try{localStorage.removeItem(AIK)}catch(_){}msg(errFull(e))}
}

/* weather: Open-Meteo, العجمي - الإسكندرية */
const WX={lat:31.10,lon:29.77},WXK="lifeos_wx";
function wxInfo(c,day){
  if(c===0)return day?["fa-sun","مشمس","#ff9f0a"]:["fa-moon","صافي","#8e8cf0"];
  if(c===1||c===2)return day?["fa-cloud-sun","غائم جزئياً","#ff9f0a"]:["fa-cloud-moon","غائم جزئياً","#8e8cf0"];
  if(c===3)return ["fa-cloud","غائم","#8e9aae"];
  if(c===45||c===48)return ["fa-smog","ضباب","#8e9aae"];
  if(c>=51&&c<=57)return ["fa-cloud-rain","رذاذ","#4aa3ff"];
  if(c>=61&&c<=67||c>=80&&c<=82)return ["fa-cloud-showers-heavy","مطر","#2f8cff"];
  if(c>=71&&c<=77||c===85||c===86)return ["fa-snowflake","ثلج","#5ac8fa"];
  if(c>=95)return ["fa-cloud-bolt","عاصفة رعدية","#af52de"];
  return ["fa-cloud","غائم","#8e9aae"];
}
const wxEl=$("#wx");
function wxWidth(){
  const t=$(".wxt",wxEl),s=$(wxEl.classList.contains("intro")?".wl":".wc",wxEl);
  t.style.width=s.scrollWidth+2+"px";
}
function applyWx(d){
  const [ic,tx,col]=wxInfo(d.code,d.day);
  $("#wxI").innerHTML=`<i class="fa-solid ${ic}"></i>`;$("#wxI").style.color=col;
  $("#wxC").textContent=`${tx} ${d.temp}°`;
  wxWidth();
}
async function loadWx(){
  const c=lsGet(WXK,null);
  if(c&&Date.now()-c.t<20*60*1000){applyWx(c);return}
  try{
    const r=await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${WX.lat}&longitude=${WX.lon}&current=temperature_2m,weather_code,is_day&timezone=Africa%2FCairo`);
    if(!r.ok)throw new Error("wx");
    const cur=(await r.json()).current;
    const d={t:Date.now(),temp:Math.round(cur.temperature_2m),code:cur.weather_code,day:cur.is_day===1};
    lsSet(WXK,d);applyWx(d);
  }catch(e){if(c)applyWx(c);else{$("#wxC").textContent="الطقس غير متاح";wxWidth()}}
}
const h12=d=>{const h=d.getHours();return `${h%12||12}:${pad(d.getMinutes())} ${h<12?"ص":"م"}`};
function tickClock(){$("#wxClk").textContent=h12(new Date())}
let wxStarted=false;
function startWx(){
  if(wxStarted)return;wxStarted=true;
  wxEl.classList.remove("pre");wxWidth();
  setTimeout(()=>{wxEl.classList.remove("intro");wxWidth()},2600);
}
tickClock();setInterval(tickClock,10000);loadWx();
wxWidth();
if(document.fonts&&document.fonts.ready)document.fonts.ready.then(wxWidth);

/* =====================================================
   SALAH REMINDER + PWA + TAP FX
===================================================== */
const SK="lifeos_salah";
let salah=Object.assign({on:false,min:30,quiet:true,last:0},lsGet(SK,{}));
const SALAH_TXT=[
  "اللهم صلِّ وسلِّم على نبينا محمد ﷺ",
  "صلّوا على النبي ﷺ… ريّح قلبك دقيقة",
  "اللهم صلِّ على محمد وعلى آل محمد",
  "«من صلّى عليّ صلاة صلّى الله عليه بها عشرًا» ﷺ",
  "اللهم صلِّ وسلِّم وبارك على سيدنا محمد",
  "الصلاة على النبي ﷺ نور لقلبك وراحة لبالك",
  "ﷺ اللهم صلِّ على النبي المصطفى وعلى آله وصحبه وسلم",
  "كمّل مذاكرتك وصلّي على النبي ﷺ"
];
const saveSalah=()=>lsSet(SK,salah);
const swReg=async()=>{try{return navigator.serviceWorker?await navigator.serviceWorker.getRegistration():null}catch(e){return null}};
async function notify(title,body){
  const opts={body,icon:"icons/icon-192.png",badge:"icons/favicon-64.png",tag:"salah",renotify:true,lang:"ar",dir:"rtl",data:{url:"./"}};
  const reg=await swReg();
  if(reg&&reg.showNotification)return reg.showNotification(title,opts);
  if("Notification" in window)new Notification(title,opts);
}
const salahPick=()=>SALAH_TXT[Math.floor(Math.random()*SALAH_TXT.length)];
function salahDue(){
  if(!salah.on||!("Notification" in window)||Notification.permission!=="granted")return false;
  if(salah.quiet&&new Date().getHours()<6)return false;
  return Date.now()-salah.last>=salah.min*60000;
}
function tickSalah(){if(!salahDue())return;salah.last=Date.now();saveSalah();notify("صلِّ على النبي ﷺ",salahPick())}
setInterval(tickSalah,30000);
document.addEventListener("visibilitychange",()=>{if(!document.hidden)tickSalah()});
async function pushCfg(){
  const reg=await swReg();
  if(reg&&reg.active)reg.active.postMessage({type:"cfg",on:salah.on,quiet:salah.quiet,min:salah.min});
  if(reg&&"periodicSync" in reg){
    try{
      if(salah.on){const st=await navigator.permissions.query({name:"periodic-background-sync"});if(st.state==="granted")await reg.periodicSync.register("salah",{minInterval:Math.max(salah.min,60)*60000})}
      else await reg.periodicSync.unregister("salah");
    }catch(e){}
  }
}
function paintSalah(){
  $("#salahSw").setAttribute("aria-checked",salah.on);
  $("#quietSw").setAttribute("aria-checked",salah.quiet);
  $("#salahInt").value=String(salah.min);
  const n=$("#salahNote");
  if(!("Notification" in window))n.textContent="المتصفح ده مبيدعمش الإشعارات.";
  else if(Notification.permission==="denied")n.textContent="الإشعارات متقفلة للموقع ده. افتح إعدادات المتصفح وسمح بيها وارجع فعّل.";
  else n.textContent="الإشعارات بتشتغل والتطبيق مفتوح أو متثبّت على جهازك.";
}
async function ensurePerm(){
  if(!("Notification" in window))return false;
  if(Notification.permission==="default"){try{await Notification.requestPermission()}catch(e){}}
  return Notification.permission==="granted";
}
$("#salahSw").addEventListener("click",async()=>{
  if(!salah.on){
    if(!(await ensurePerm())){paintSalah();return}
    salah.on=true;salah.last=Date.now();saveSalah();notify("تم التفعيل ✓","هتوصلك تذكيرة بالصلاة على النبي ﷺ كل "+salah.min+" دقيقة");
  }else{salah.on=false;saveSalah()}
  paintSalah();pushCfg();
});
$("#quietSw").addEventListener("click",()=>{salah.quiet=!salah.quiet;saveSalah();paintSalah();pushCfg()});
$("#salahInt").addEventListener("change",e=>{salah.min=+e.target.value;saveSalah();pushCfg()});
$("#salahTest").addEventListener("click",async()=>{
  if(!(await ensurePerm())){paintSalah();return}
  notify("صلِّ على النبي ﷺ",salahPick());
});

/* install */
let deferredInstall=null;
const isStandalone=()=>matchMedia("(display-mode: standalone)").matches||navigator.standalone===true;
window.addEventListener("beforeinstallprompt",e=>{e.preventDefault();deferredInstall=e;paintInstall()});
window.addEventListener("appinstalled",()=>{deferredInstall=null;paintInstall()});
function paintInstall(){
  const b=$("#installBtn"),n=$("#installNote"),ios=/iphone|ipad|ipod/i.test(navigator.userAgent);
  if(isStandalone()){b.style.display="none";n.textContent="التطبيق متثبّت ✓";return}
  b.style.display="";
  if(deferredInstall){n.textContent="هيتثبّت على جهازك ويفتح زي أي تطبيق.";return}
  if(ios)n.textContent="على iPhone: من Safari اضغط زرار المشاركة ثم Add to Home Screen.";
  else n.textContent="لو الزرار مش شغال: افتح الموقع من Chrome أو Edge على رابط https، ومن قايمة المتصفح اختار تثبيت التطبيق.";
}
$("#installBtn").addEventListener("click",async()=>{
  if(deferredInstall){deferredInstall.prompt();try{await deferredInstall.userChoice}catch(e){}deferredInstall=null;paintInstall()}
  else paintInstall();
});
if("serviceWorker" in navigator&&/^https?:$/.test(location.protocol)){
  navigator.serviceWorker.register("sw.js").then(()=>navigator.serviceWorker.ready).then(()=>pushCfg()).catch(()=>{});
}
paintSalah();paintInstall();

