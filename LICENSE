function classSubjects(dow){return uniq((SCHEDULE[dow]||[]).map(c=>c.s))}

function collegeTasks(iso,dow){
  const out=[];
  const p=PLAN[iso];
  const subs=classSubjects(dow);
  if(p){
    p.forEach((x,n)=>out.push({id:`col-${iso}-${n}`,s:x.s,t:x.t,m:x.m||60}));
    if(subs.length) out.push({id:`col-${iso}-r`,s:"مراجعة",t:`راجع محاضرات النهاردة: ${subs.join("، ")} (٢٠ دقيقة لكل مادة)`,m:Math.min(60,subs.length*20)});
  }else{
    if(subs.length) out.push({id:`col-${iso}-r`,s:"مراجعة",t:`راجع محاضرات النهاردة: ${subs.join("، ")} (٢٠ دقيقة لكل مادة)`,m:Math.min(80,subs.length*20)});
    const tom=classSubjects((dow+1)%7);
    if(tom.length) out.push({id:`col-${iso}-n`,s:"تحضير",t:`بصّ على محاضرات بكرة: ${tom.join("، ")} (١٥ دقيقة)`,m:15});
    if(!out.length) out.push({id:`col-${iso}-f`,s:"مراجعة",t:"يوم بدون محاضرات — خد ساعة كاملة على مادة حاسس إنك متأخر فيها",m:60});
  }
  return out;
}

/* =====================================================
   STATE
===================================================== */
let cyberDone=new Set(lsGet(PKEY,[]));
let done=lsGet(DKEY,{});
let custom=lsGet(CKEY,{});
let activity=new Set(lsGet(AKEY,[]));
const ui={tab:"today",col:"week",cy:"g"};

function gId(i){return `google-${i+1}`}
function wId(i,j){return `soc-${i+1}-week-${j+1}`}
/* توافق مع الحفظ القديم لمراحل SOC */
[...cyberDone].forEach(id=>{
  if(/^soc-\d+$/.test(id)){
    const i=+id.split("-")[1]-1;
    (socDetails[i]||[]).forEach((_,j)=>cyberDone.add(wId(i,j)));
    cyberDone.delete(id);
  }
});

function saveCyber(){lsSet(PKEY,[...cyberDone])}
function markActivity(){const t=isoOf(new Date());if(!activity.has(t)){activity.add(t);lsSet(AKEY,[...activity])}}
function streak(){
  const d=new Date();
  if(!activity.has(isoOf(d)))d.setDate(d.getDate()-1);
  let n=0;
  while(activity.has(isoOf(d))){n++;d.setDate(d.getDate()-1)}
  return n;
}

/* ---------- cyber logic (same rules as the original) ---------- */
function googleUnlocked(i){for(let k=0;k<i;k++)if(!cyberDone.has(gId(k)))return false;return true}
function toggleGoogle(i){
  const id=gId(i);
  if(!googleUnlocked(i))return;
  if(cyberDone.has(id)){for(let k=i;k<googleDays.length;k++)cyberDone.delete(gId(k))}
  else{cyberDone.add(id);markActivity()}
  afterCyber();
}
function toggleWeek(i,j){
  const id=wId(i,j);
  if(cyberDone.has(id))cyberDone.delete(id);else{cyberDone.add(id);markActivity()}
  afterCyber();
}
function afterCyber(){saveCyber();updateCyberUI();renderToday()}

function pickCyber(){
  for(let i=0;i<googleDays.length;i++)if(!cyberDone.has(gId(i)))return {k:"g",i};
  for(let i=0;i<socDetails.length;i++)for(let j=0;j<socDetails[i].length;j++)if(!cyberDone.has(wId(i,j)))return {k:"w",i,j};
  return null;
}
function cyberToday(iso){
  const st=lsGet(TKEY,null);
  if(st&&st.date===iso&&st.ref!==undefined)return st.ref;
  const ref=pickCyber();
  lsSet(TKEY,{date:iso,ref});
  return ref;
}
function refInfo(r){
  if(r.k==="g"){
    const d=googleDays[r.i];
    return {id:`g:${r.i}`,title:d[2],sub:`${d[0]} · ${d[1]}`,link:d[3],done:cyberDone.has(gId(r.i))};
  }
  const w=socDetails[r.i][r.j];
  return {id:`w:${r.i}:${r.j}`,title:w.title,sub:`${socData[r.i][1]} · ${w.week}`,link:(w.links[0]||[])[1]||"",done:cyberDone.has(wId(r.i,r.j))};
}
function toggleRefId(id){
  const p=id.split(":");
  if(p[0]==="g")toggleGoogle(+p[1]);else toggleWeek(+p[1],+p[2]);
}

