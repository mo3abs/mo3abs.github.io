  const c=e.target.closest(".ck[data-id]");if(!c)return;
  const id=c.dataset.id;
  requestAnimationFrame(()=>{const n=document.querySelector(`.ck[data-id="${CSS.escape(id)}"]`);if(n&&n.closest(".done,.completed")){n.classList.add("pop")}});
});

/* quote of the day (tap = next) */
const yday=()=>Math.floor((Date.now()-new Date(new Date().getFullYear(),0,0))/864e5);
let qi=(yday()*7)%quotes.length;
function paintQuote(){const q=$("#tQuote");if(q)q.textContent=`"${quotes[qi]}"`}
$("#tQuote").addEventListener("click",()=>{
  const q=$("#tQuote");q.classList.add("swap");
  setTimeout(()=>{qi=(qi+1)%quotes.length;paintQuote();q.classList.remove("swap")},220);
});

