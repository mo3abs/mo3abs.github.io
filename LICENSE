function cyberTotals(){
  const g=googleDays.length;
  let w=0;socDetails.forEach(a=>w+=a.length);
  let gd=0;for(let i=0;i<g;i++)if(cyberDone.has(gId(i)))gd++;
  let wd=0;socDetails.forEach((a,i)=>a.forEach((_,j)=>{if(cyberDone.has(wId(i,j)))wd++}));
  return {total:g+w,done:gd+wd,gd,wd};
}
function cyberPercent(){const t=cyberTotals();return t.total?Math.round(t.done/t.total*100):0}

function updateCyberUI(){
  let cur=-1;
  googleDays.forEach((_,i)=>{
    const el=$(`[data-g="${i}"]`);if(!el)return;
    const comp=cyberDone.has(gId(i)),unl=googleUnlocked(i);
    el.classList.toggle("completed",comp);
    el.classList.toggle("locked",!unl);
    const st=$("[data-st]",el);
    if(comp){st.className="st ok";st.textContent="مكتمل"}
    else if(unl){st.className="st cur";st.textContent="الحالي";cur=i}
    else{st.className="st";st.textContent=""}
  });
  const note=$("#gNote");
  if(note)note.textContent=cur>=0?`فاضل ${googleDays.length-cur-1} يوم بعد اليوم الحالي.`:"خلّصت كل الـ 25 يوم — برافو!";
  socDetails.forEach((ws,i)=>{
    let n=0;
    ws.forEach((_,j)=>{
      const c=cyberDone.has(wId(i,j));if(c)n++;
      $(`[data-w="${i}-${j}"]`)?.classList.toggle("completed",c);
    });
    const card=$(`[data-soc="${i}"]`);
    card?.classList.toggle("completed",ws.length>0&&n===ws.length);
    const sp=$(`[data-sp="${i}"]`);if(sp)sp.textContent=`${n} / ${ws.length} أسابيع`;
  });
  const t=cyberTotals(),pc=cyberPercent();
  $("#cyPct").textContent=pc+"%";
  $("#cyFill").style.width=pc+"%";
  $("#cyCount").textContent=`${t.done} من ${t.total} مهمة · ${t.gd}/${googleDays.length} يوم Google · ${t.wd} أسبوع SOC`;
  applySearch();
}

function applySearch(){
  const q=($("#cySearch").value||"").toLowerCase().trim();
  $$("#gList .gi").forEach(r=>{r.style.display=q&&!r.textContent.toLowerCase().includes(q)?"none":""});
  $$("#cy-soc .soc").forEach(c=>{c.style.display=q&&!c.textContent.toLowerCase().includes(q)?"none":""});
}

/* news */
function timeAgo(d){
  if(isNaN(d.getTime()))return "حديث";
  const m=Math.floor((Date.now()-d)/60000);
  if(m<1)return"الآن";if(m<60)return`منذ ${m} دقيقة`;
  const h=Math.floor(m/60);if(h<24)return`منذ ${h} ساعة`;
  return`منذ ${Math.floor(h/24)} يوم`;
}
async function loadNews(){
  const box=$("#newsList");
  try{
    const u=encodeURIComponent("https://feeds.feedburner.com/TheHackersNews");
    const r=await fetch(`https://api.rss2json.com/v1/api.json?rss_url=${u}`);
    if(!r.ok)throw new Error("net");
    const j=await r.json();
    if(!j.items||!j.items.length)throw new Error("empty");
    box.innerHTML=j.items.slice(0,8).map(a=>`
      <div class="news-i"><div class="meta"><span style="color:var(--blue)">THE HACKER NEWS</span><span>${timeAgo(new Date(a.pubDate))}</span></div>
      <h4>${esc(a.title||"")}</h4>
      <a class="chip" href="${esc(safeUrl(a.link))}" target="_blank" rel="noopener noreferrer">قراءة الخبر <i class="fa-solid fa-arrow-up-right-from-square"></i></a></div>`).join("");
  }catch(e){
    box.innerHTML=`<div class="loading"><i class="fa-solid fa-triangle-exclamation"></i> تعذر تحديث الأخبار دلوقتي، جرّب بعد شوية.</div>`;
  }
}

